# /opt/decrastination/.env, mode 0600. Every secret lives here and nowhere else on the box; compose.yaml
# gives each service only its own. No values in this file: it's in a public repository.

# The website's name, and the image tag to run: latest, or a version to hold on to one.
DOMAIN=decrastination.thomaswhite.me
IMAGE_TAG=latest

# Encrypts the credentials at rest (base64 of 32 random bytes). bootstrap.sh makes it once. Keep a copy
# off the box: a restored database can't be read without it.
MASTER_KEY=

# The GitHub App's sign-in, and the only account let in (its numeric id).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_ID=

# Claude's key, and where the minute's heartbeat goes: used once the server applies commands (D-141).
ANTHROPIC_API_KEY=
HEARTBEAT_URL=

# Backblaze B2: the nightly file, under a key of its own that can write and not delete (W-20).
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=decrastination-nightly

# Cloudflare R2: Litestream's live copy, its key for this bucket alone.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=decrastination-db
