# Caddy terminates TLS with a certificate from Let's Encrypt, renewed on its own, serves the website
# and forwards /api to the server. DOMAIN comes from the service's environment.

# What a log line may hold of a request: what was asked and how it went, with no headers and no sign-in's one-time code, as Caddy
# masks only the headers it knows hold a credential. On both loggers: a request that fails is written by the default one.
(request_lines) {
	format filter {
		wrap json
		request>headers delete
		resp_headers delete
		request>uri query {
			delete code
			delete state
		}
	}
}

{
	log default {
		import request_lines
	}
}

{$DOMAIN} {
	# Not the event stream: each event has to reach the browser as it's sent, not when a compressor has enough to emit.
	@compressed not path /api/events
	encode @compressed zstd gzip

	handle /api/* {
		reverse_proxy server:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# Vite names each built file by its content; the page itself is always asked for again, so a deploy shows at once.
		@built path /assets/*
		header @built Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'"
	}

	log {
		output stdout
		import request_lines
	}
}
