<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Teams Assignments widget's provider (docs/data-sources.md §1). Signature-level, so it
         is granted without asking because both apps are signed with the same key. Defined here
         as well as there, identically, so the order the two are installed in doesn't matter. -->
    <permission
        android:name="com.teamsassignments.widget.permission.READ_ASSIGNMENTS"
        android:description="@string/read_assignments_permission_description"
        android:label="@string/read_assignments_permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.teamsassignments.widget.permission.READ_ASSIGNMENTS" />

    <!-- AnkiDroid's provider (docs/data-sources.md §3): a runtime permission, granted once. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <!-- Package visibility (Android 11+): the apps whose providers this reads. -->
    <queries>
        <package android:name="com.teamsassignments.widget" />
        <package android:name="com.ichi2.anki" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Decrastination">

        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown over a blocked app. Its own task, so Back and Recents can't reveal the app behind. -->
        <activity
            android:name=".probe.BlockedProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.thomaswcode.decrastination.blocked" />

        <!-- Only the system can bind it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".probe.FocusProbeService"
            android:exported="true"
            android:label="@string/focus_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_service_config" />
        </service>
    </application>

</manifest>
