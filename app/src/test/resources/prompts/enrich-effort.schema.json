{
    "type": "object",
    "properties": {
        "effortMin": {
            "type": "integer",
            "description": "The minutes in all; with blocks, their sum"
        },
        "blocks": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "minutes": {
                        "type": "integer",
                        "description": "All its work, however long (the app cuts one over 60 minutes into sittings itself); never over 600"
                    },
                    "from": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "The date before which this block can't be done, only if the text gives one; never after the task's due date"
                    },
                    "due": {
                        "anyOf": [
                            {
                                "type": "string",
                                "description": "Local date and time, YYYY-MM-DDTHH:MM, or the date alone, YYYY-MM-DD"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "anyOrder": {
                        "type": "boolean",
                        "description": "true where it doesn't need the blocks before it done first; false where it builds on them, and for the first"
                    }
                },
                "required": [
                    "title",
                    "minutes",
                    "from",
                    "due",
                    "anyOrder"
                ],
                "additionalProperties": false
            }
        },
        "summary": {
            "type": "string",
            "description": "What a text longer than about 600 characters asks of the student, from all of it, in at most 400 characters; empty for a shorter one"
        }
    },
    "required": [
        "effortMin",
        "blocks",
        "summary"
    ],
    "additionalProperties": false
}
